# Plane Development Container
# Multi-runtime: Node 22 + Python 3.12 for full-stack development
FROM mcr.microsoft.com/devcontainers/typescript-node:22

# Install Python 3.12 + pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    libffi-dev \
    build-essential \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Make python3.12 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# Enable pnpm via corepack (version managed by package.json)
RUN corepack enable pnpm

# Install Ruff (Python linter/formatter) globally
RUN pip install --break-system-packages ruff==0.9.7

# Install useful dev tools
RUN npm install -g turbo@2.6.3

# Set working directory
WORKDIR /workspace

# Expose dev server ports
EXPOSE 3000 3001 3002 3100 8000
